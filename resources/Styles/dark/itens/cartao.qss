/*
 * itens/cartao - Qt Style Sheet
 * Created: 24/07/2026
 *
 * Estilo do item de lista da categoria "Cartoes".
 */

QFrame#frame_cartao_item {
    background: transparent;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

QPushButton#btn_cartao_item_icon {
    background-color: rgba(107, 140, 255, 0.14);
    background-image: url(:/images/icons/normal/logo_cartao.png);
    background-repeat: no-repeat;
    background-position: center;
    border-radius: 10px;
}

QLabel#label_cartao_titulo {
    font-family: "Segoe UI Variable Text", "Segoe UI", -apple-system, BlinkMacSystemFont, "Inter", sans-serif;
    font-size: 14px;
    font-weight: bold;
    color: #e8eaf0;
}

QLabel#label_cartao_subtitulo {
    color: rgb(166, 176, 208);
    font-size: 12px;
}

QPushButton#btn_favorito_cartao_item {
    border-radius: 20px;
}
QPushButton#btn_remover_cartao_item {
    background-color: transparent;
    border-radius: 20px;
}