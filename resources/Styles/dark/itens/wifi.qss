/*
 * itens/wifi - Qt Style Sheet
 * Created: 24/07/2026
 *
 * Estilo do item de lista da categoria "Wifi".
 */



QPushButton#btn_icone_wifi {
    background-color: rgba(107, 140, 255, 0.14);
    background-image: url(:/images/28x28/logo_wifi.png);
    background-repeat: no-repeat;
    background-position: center;
    border-radius: 10px;
}

QLabel#label_wifi {
    font-family: "Segoe UI Variable Text", "Segoe UI", -apple-system, BlinkMacSystemFont, "Inter", sans-serif;
    font-size: 14px;
    font-weight: bold;
    background-color: rgb(56, 67, 110);
    border-radius: 10px;
    color: rgb(166, 176, 208);
}

#btn_oculta_passoword_wifi {
      background-image: url(:/images/icons/normal/logo_favorite.png);
      background-repeat: no-repeat;
      background-position: center;
}

QPushButton#btn_favorito_wifi_item {
    border-radius: 20px;
}