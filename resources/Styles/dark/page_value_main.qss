/* Add your QSS styles here */

#label_login {
   background: rgb(56, 67, 110);
   color: rgb(166, 176, 208);
   border-radius: 10px;
   background-position: center;
   font-family: "Segoe UI Variable Text", "Segoe UI", -apple-system, BlinkMacSystemFont, "Inter", sans-serif;
}

QPushButton {
    background-image: url(:/images/icons/normal/logo_favorite.png);
    background-position: center;
    background-repeat: no-repeat;
    background: rgb(69, 81, 131);
    border-radius: 20px;
}

#btn_teste {
  background-image: url(:/images/56x56/ly_chave.png);
 background-color: rgba(107,140,255,0.14);
 border-radius: 10px;
}

#btn_favorito_login_item {

}

QLineEdit#line_search {
    background-image: url(:/images/16x16/logo_search.png);
    background-position: left center;
    background-repeat: no-repeat;
    background-color: rgb(56, 67, 110);
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.08);
    padding-left: 30px;
}

QLineEdit#line_search:focus{
  border: 1px solid #6b8cff;
}
QStackedWidget#stackedWidget_2 {
   background: rgb(26, 34, 64);
   border-left: 2px solid rgba(255,255,255,0.08)
}

#listView,#frame_19{
  background-color:  #232c4d
}

#btn_search {
   background-image: url(:/images/36x36/logo_add.png);
    background-position: center;
    background-repeat: no-repeat;
    border-radius: 20px;
}

QFrame#frame_19 {
 background-color: #232c4d;
 border-bottom: 2px solid rgba(255,255,255,0.08)
}
QFrame#frame_15{
background: rgb(35, 44, 77);
border-right: 2px solid rgba(255,255,255,0.08)
}

QPushButton#btn_cartao {
    background: rgb(35, 44, 77);
    background-image: url(:/images/icons/normal/logo_cartao.png);
    background-repeat: no-repeat;
    background-position: center;
    border-radius: none;
}
