/* Add your QSS styles here */

mainwindow {
 background-color: rgb(26, 34, 64);
}
QLabel {
  font-family: "Segoe UI Variable Text", "Segoe UI", -apple-system, BlinkMacSystemFont, "Inter", sans-serif;
  color: rgb(122, 133, 168);
}
#label_8 {
  color: rgb(232, 236, 247);
 font-family: ui-monospace, "SF Mono", Menlo, Monaco, monospace;
}
#label_6 {
  color: rgb(122, 133, 168);
  font-family: ui-monospace, "SF Mono", Menlo, Monaco, monospace;
}
#label_7 {
color: rgb(122, 133, 168);
}

QProgressBar {
 border: none;
    background: transparent;
    background-color: transparent;

}

#btn_back {
   background-color: none;
   border-radius: none;
}
#btn_back:hover{
   background-color: rgb(56, 67, 110);
   border: none;
       border-radius: 8px;
}
QLineEdit {
         background-color: #2d3654;
         border: 1px solid #3a4368;
         border-radius: 8px;
         padding: 10px 14px;
         color: #e8eaf0;
         font-size: 14px;
     }
QLineEdit:focus {
         border: 1px solid #5865f2;
         background-color: #313a5c;
   }

#btn_create_cofre_cp {
    background-color: #5865f2;
    color: #ffffff;
    border: none;
    border-radius: 8px;
    padding: 12px 20px;
    font-size: 14px;
    font-weight: 600;
    min-height: 20px;
}


#btn_create_cofre_cp:hover {
    background-color: #6873f5;
}

/* Efeito ao clicar (pressed) */
#btn_create_cofre_cp:pressed {
    background-color: #4a56d6;
}

#btn_create_cofre_cp:disabled {
    background-color: #3a4368;
    color: #7b839e;
}

