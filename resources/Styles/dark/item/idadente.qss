/*
 * item/idadente - Qt Style Sheet
 * Created: 24/07/2026
 *
 * Estilo do item de lista da categoria "Identidade".
 * Nome do arquivo usa "idadente" para bater com o nome ja
 * estabelecido no codigo (btn_idadente / logo_idadente.png).
 */

QFrame#frame_idadente_item {
    background: transparent;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
}

QPushButton#btn_idadente_item_icon {
    background-color: rgba(107, 140, 255, 0.14);
    background-image: url(:/images/icons/normal/logo_idadente.png);
    background-repeat: no-repeat;
    background-position: center;
    border-radius: 10px;
}

QLabel#label_idadente_titulo {
    font-family: "Segoe UI Variable Text", "Segoe UI", -apple-system, BlinkMacSystemFont, "Inter", sans-serif;
    font-size: 14px;
    font-weight: bold;
    color: #e8eaf0;
}

QLabel#label_idadente_subtitulo {
    color: rgb(166, 176, 208);
    font-size: 12px;
}

QPushButton#btn_favorito_idadente_item {
    background-image: url(:/images/icons/normal/logo_favorite.png);
    background-repeat: no-repeat;
    background-position: center;
    border-radius: 20px;
}
QPushButton#btn_favorito_idadente_item:hover {
    background-color: rgba(107, 140, 255, 0.14);
}

QPushButton#btn_remover_idadente_item {
    background-color: transparent;
    border-radius: 20px;
}
QPushButton#btn_remover_idadente_item:hover {
    background-color: rgba(239, 107, 107, 0.14);
}