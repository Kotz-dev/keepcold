/* Add your QSS styles here */
mainwindow {
 background-color: rgb(26, 34, 64);
}

QPushButton#btn_create_cofre {
 outline: none;
   background-color: #2d3654;
       background-image: url(:/imagen/images/logo_create.png);
       background-repeat: no-repeat;
       background-position: top left;
       background-origin: content;
       padding-top: 20px;              /* empurra o texto pra baixo, abrindo espaço pro ícone */
       padding-left: 16px;
       padding-right: 16px;
       padding-bottom: 16px;
       border: 1px solid #3a4368;
       border-radius: 12px;
       text-align: left;
       font-size: 13px;
       color: #e8eaf0;
}
QPushButton#btn_open_cofre{
 outline: none;
background-color: #2d3654;
       background-image: url(:/imagen/images/logo_open_cp.png);
       background-repeat: no-repeat;
       background-position: top left;
       background-origin: content;
       padding-top: 20px;              /* empurra o texto pra baixo, abrindo espaço pro ícone */
       padding-left: 16px;
       padding-right: 16px;
       padding-bottom: 16px;
       border: 1px solid #3a4368;
       border-radius: 12px;
       text-align: left;
       font-size: 13px;
       color: #e8eaf0;
}

QPushButton#btn_create_cofre:hover {
 outline: none;
    background-color: #343e60;      /* leve destaque ao passar mouse */
    border: 1px solid #5865f2;
}
QPushButton#btn_open_cofre:hover {
 outline: none;
    background-color: #343e60;      /* leve destaque ao passar mouse */
    border: 1px solid #5865f2;
}

QPushButton#btn_create_cofre:pressed {
 outline: none;
    background-color: #28304a;
}
QPushButton#btn_open_cofre:pressed {
 outline: none;
    background-color: #28304a;
}