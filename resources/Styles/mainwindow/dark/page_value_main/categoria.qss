/*
 * categoria - Qt Style Sheet
 * Created: 29/07/2026
 *
 * Botoes do menu lateral de categorias (page_value_main).
 */

QPushButton#btn_cartao {
    background: rgb(35, 44, 77);
    background-image: url(:/images/icons/normal/logo_cartao.png);
    background-repeat: no-repeat;
    background-position: center;
    border-radius: none;
}
QPushButton#btn_cartao:hover {
    background: rgba(107, 140, 255, 0.14);
    background-image: url(:/images/icons/normal/logo_cartao.png);
    background-repeat: no-repeat;
    background-position: center;
    border-radius: 10px;
}
QPushButton#btn_cartao:pressed {
    background: rgba(107, 140, 255, 0.24);
    background-image: url(:/images/icons/pressed/logo_cartao.png);
    background-repeat: no-repeat;
    background-position: center;
    border-radius: 10px;
}

