/*
 * itens/recuperacao - Qt Style Sheet
 * Created: 24/07/2026
 *
 * Estilo do item de lista da categoria "Recuperacao".
 */


QPushButton#btn_icone_recuperacao {
    background-color: rgba(107, 140, 255, 0.14);
    background-image: url(:/images/28x28/logo_recuperacao.png);
    background-repeat: no-repeat;
    background-position: center;
    border-radius: 10px;
}
#label_recuperacao{
      font-size: 10px;
      font-weight: bold;
      background-color: rgb(56, 67, 110);
      border-radius: 10px;
      color: rgb(166, 176, 208);
}

QLabel#label_recuperacao_titulo {
    font-family: "Segoe UI Variable Text", "Segoe UI", -apple-system, BlinkMacSystemFont, "Inter", sans-serif;
    font-size: 14px;
    font-weight: bold;
    color: #e8eaf0;
}

QLabel#label_recuperacao_subtitulo {
    color: rgb(166, 176, 208);
    font-size: 12px;
}

QPushButton#btn_favorito_recuperacao {
    border-radius: 20px;
}

QPushButton#btn_remover_recuperacao {
    border-radius: 20px;
}