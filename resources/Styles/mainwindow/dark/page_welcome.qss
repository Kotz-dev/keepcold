/* Add your QSS styles here */

#centralwidget {
      background-color: #1a2138;
     border-radius: 12px;
    }


QPushButton#Welcome_btn_criar_cofre,
QPushButton#Welcome_btn_abrir_cofre {
    outline: none;
    background-color: #2d3654;
    background-repeat: no-repeat;
    background-position: top left;
    background-origin: content;
    padding-top: 20px;              /* empurra o texto pra baixo, abrindo espaço pro ícone */
    padding-left: 16px;
    padding-right: 16px;
    padding-bottom: 16px;
    border: 1px solid #3a4368;
    border-radius: 12px;
    text-align: left;
    font-size: 13px;
    color: #e8eaf0;
}
QPushButton#Welcome_btn_criar_cofre {
    background-image: url(:/images/36x36/logo_create.png);
}
QPushButton#Welcome_btn_abrir_cofre {
    background-image: url(:/images/36x36/logo_open_cp.png);
}

QPushButton#Welcome_btn_criar_cofre:hover,
QPushButton#Welcome_btn_abrir_cofre:hover {
    outline: none;
    background-color: #343e60;      /* leve destaque ao passar mouse */
    border: 1px solid #5865f2;
}

QPushButton#Welcome_btn_criar_cofre:pressed,
QPushButton#Welcome_btn_abrir_cofre:pressed {
    outline: none;
    background-color: #28304a;
}