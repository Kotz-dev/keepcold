 * - Use Ctrl+/ (Cmd+/) to comment/uncomment code blocks
 * - Use the QSS Colors panel and editor context menu to save or insert colors
 */

/* Add your QSS styles here */


#btn_fechar {
  background-image: url(:/images/46x35/close_window.png);
  background-repeat: no-repeat;
  background-position: center;
  border-radius: 15px;
}


#windowConfig {
  border-radius: 16px;
}


#barra_titule_config {
border-top-left-radius: 16px;
 border-top-right-radius: 16px;
 border-bottom-left-radius: 0px;
 border-bottom-right-radius: 0px;
  background: #232c4d;
  border: 1px solid rgba(255, 255, 255, 0.14);
}

#frame_2 {
  background: #232c4d;
  border: 1px solid rgba(255, 255, 255, 0.14);
}

#frame_19 {
background: #2c3760;
}

#frame_rodape {
         border-top-left-radius: 0px;
         border-top-right-radius: 0px;
         border-bottom-left-radius: 16px;
         border-bottom-right-radius: 16px;
         background: #232c4d;
         border: 1px solid rgba(255, 255, 255, 0.14);
}

#frame_update,#frame_bloqueio_auto,#frame_modo_escuro,#frame_senha_mestra,#frame_import_export,#frame_sobre,#frame_idioma {
     background: #2c3760;
     border: 1px solid rgba(255, 255, 255, 0.08);
     border-radius: 10px;
     padding: 16px;
}

#label_19,#label_4,#label_7,#label_10 {
     color: #e8ecf7;
     font-size: 14px;
     font-weight: 500;
     background: transparent;
     border: none;
 }

#label_20 {
    color: #7a85a8;
    font-size: 12px;
    background: transparent;
    border: none;
}




QPushButton {
    background: #38436e;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 7px;
    color: #e8ecf7;
    font-weight: 500;
    padding: 9px 16px;
    text-align: center;
}
QPushButton:hover {
    background: #455183;
}
QPushButton:pressed {
    background: #455183;
    padding-top: 10px;
    padding-bottom: 8px;
}
QPushButton:disabled {
    background: #38436e;
    color: #6b7391;
    border-color: rgba(255, 255, 255, 0.04);
}


QComboBox {
    background: #38436e;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 7px;
    color: #e8ecf7;
    font-size: 14px;
    min-width: 130px;
}
QComboBox:hover {
    border-color: rgba(255, 255, 255, 0.14);
}
QComboBox:focus {
    border-color: #6b8cff;
    background: #2c3760;
}
QComboBox::drop-down {
    border: none;
    width: 26px;
}
QComboBox::down-arrow {
    image: url(:/images/12x12/logo_chevron.png);
}

/* lista suspensa */
QComboBox QAbstractItemView {
    background: #232c4d;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 8px;
    color: #e8ecf7;
    padding: 4px;
    outline: none;
    selection-background-color: #6b8cff;
    selection-color: #ffffff;
}
QComboBox QAbstractItemView::item {
    min-height: 30px;
    padding: 0 8px;
    border-radius: 6px;
}
QComboBox QAbstractItemView::item:hover {
    background: #38436e;
}

QLabel#srTitle {
    color: #e8ecf7;
    font-size: 14px;
    font-weight: 500;
    background: transparent;
    border: none;
}

QLabel#srSub {
    color: #7a85a8;
    font-size: 12px;
    background: transparent;
    border: none;
}

QCheckBox {
    spacing: 0px;
    background: transparent;
    border: none;
    outline: none;
}

QCheckBox::indicator {
    width: 38px;
    height: 22px;
    border: none;
    background: transparent;
}

QCheckBox::indicator:unchecked {
    border-image: url(:/images/windowConfig/switch_off.png) 0 0 0 0 stretch stretch;
}

QCheckBox::indicator:unchecked:hover {
    border-image: url(:/images/windowConfig/switch_off.png) 0 0 0 0 stretch stretch;
}

QCheckBox::indicator:checked {
    border-image: url(:/images/windowConfig/switch_on.png) 0 0 0 0 stretch stretch;
}

QCheckBox::indicator:checked:hover {
    border-image: url(:/images/windowConfig/switch_on.png) 0 0 0 0 stretch stretch;
}

QCheckBox::indicator:disabled {
    border-image: url(:/images/windowConfig/switch_off.png) 0 0 0 0 stretch stretch;
}

#lbl_icon_update {
  background-image: url(:/images/windowConfig/img_update.png);
  background-repeat: no-repeat;
}

#lbl_icon_bloqueio_auto {
  background-image: url(:/images/windowConfig/img_block.png);
    background-repeat: no-repeat;
}
#lbl_icon_modo_escuro {
  background-image: url(:/images/windowConfig/img_secure.png);
     background-repeat: no-repeat;
}

#lbl_icon_senha_mestra {
background-image: url(:/images/windowConfig/app_key.png);
     background-repeat: no-repeat;
}
#lbl_icon_import_export {
background-image: url(:/images/windowConfig/img_download.png);
     background-repeat: no-repeat;
}
#lbl_icon_sobre {
background-image: url(:/images/windowConfig/app_sobre.png);
     background-repeat: no-repeat;
}
#lbl_icon_idioma {
 background-image: url(:/images/windowConfig/app_idioma.png);
 background-repeat: no-repeat;
}

QScrollBar:vertical {
    width: 5px;
    margin: 1px;
    background: rgba(255, 255, 255, 0.14);
}
QScrollBar::handle:vertical {
    border-radius: 5px;
    min-height: 30px;
    background: rgba(255, 255, 255, 0.14);
}
QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.24);
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
    border: none;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

