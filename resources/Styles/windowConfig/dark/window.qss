#frame_4,#frame_5,#frame_6,#frame_8,#frame_7,#frame_13 {
 background: #2c3760;
     border: 1px solid rgba(255, 255, 255, 0.08);
     border-radius: 10px;
     padding: 16px;
}

QFrame {
   background: #232c4d;
}

QDialog {
 background: #232c4d;
  border-radius: 16px;
}

